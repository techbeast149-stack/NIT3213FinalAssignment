<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView android:id="@+id/detailName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="22sp" />
    <TextView android:id="@+id/detailArchitect" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/detailLocation" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/detailYear" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/detailStyle" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/detailHeight" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/detailDescription" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" />

</LinearLayout>